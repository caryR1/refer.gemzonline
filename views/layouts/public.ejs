<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : '' %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">

  <%# Google Analytics fires on PUBLIC pages only — never the portals. %>
  <% if (ga4Id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga4Id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= ga4Id %>');
    window.rgTrack = function (name, params) {
      try { gtag('event', name, params || {}); } catch (e) {}
    };
  </script>
  <% } else { %>
  <script>window.rgTrack = function () {};</script>
  <% } %>
  <%- style %>
</head>
<body>
<%- include('../partials/env-banner') %>
  <div class="public-wrap">
    <div class="public-inner <%= typeof wide !== 'undefined' && wide ? 'wide' : '' %>">
      <div class="public-brand">
        <%- include('../partials/logo-mark', { size: 26, mono: false }) %>
        <span><%= appName %></span>
      </div>
      <%- include('../partials/flash') %>
      <%- body %>
    </div>
  </div>
<script src="/js/app.js"></script>
<%- script %>
</body>
</html>
