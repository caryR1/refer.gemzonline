<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <%- style %>
</head>
<body class="<%= bodyClass %>">
<%- include('../partials/env-banner') %>
<div class="shell">

  <header class="topbar">
    <a class="brand" href="<%= user && user.role === 'admin' ? '/admin' : '/agent' %>">
      <%- include('../partials/logo-mark', { size: 24, mono: true }) %>
      <%= appName %>
    </a>

    <span class="spacer"></span>

    <% if (user) { %>
      <div class="who">
        <span class="name"><%= user.full_name || user.email %></span>
        <span class="badge <%= user.role === 'admin' ? 'navy' : 'slate' %>"><%= user.role %></span>
        <div class="avatar" title="<%= user.email %>"><%= util.text(user.full_name || user.email).slice(0,2).toUpperCase() %></div>
        <form method="post" action="/logout">
          <button type="submit" class="linkbtn">Sign out</button>
        </form>
      </div>
    <% } %>
  </header>

  <div class="body-wrap">
    <%- include('../partials/sidebar') %>

    <main class="main <%= typeof narrow !== 'undefined' && narrow ? 'narrow' : '' %>">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>

</div>
<script src="/js/app.js"></script>
<%- script %>
</body>
</html>
