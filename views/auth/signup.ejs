<h1 style="font-size:21px;text-align:center;margin-bottom:6px">Create your agent account</h1>
<p class="center muted small" style="margin-bottom:22px">Refer people you know, earn on what closes.</p>

<% if (googleEnabled) { %>
  <a class="btn-google" href="/auth/google">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"/>
      <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"/>
      <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"/>
      <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"/>
    </svg>
    Sign up with Google
  </a>
  <div class="divider-or">or</div>
<% } %>

<form method="post" action="/signup">
  <div class="field">
    <label for="full_name">Your name</label>
    <input type="text" id="full_name" name="full_name" autocomplete="name" required
           value="<%= typeof fullName !== 'undefined' ? fullName : '' %>">
  </div>

  <div class="field">
    <label for="email">Email address</label>
    <input type="email" id="email" name="email" autocomplete="email" required
           value="<%= typeof email !== 'undefined' ? email : '' %>">
  </div>

  <div class="field">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="new-password" required minlength="8">
    <div class="help">At least 8 characters.</div>
  </div>

  <div class="field">
    <label for="timezone">Your timezone</label>
    <select id="timezone" name="timezone" data-detect-timezone>
      <% timezones.forEach(function (zone) { %>
        <option value="<%= zone %>" <%= zone === defaultTimezone ? 'selected' : '' %>><%= zone.replace(/_/g, ' ') %></option>
      <% }); %>
    </select>
    <div class="help">Every date and time in your portal is shown in this zone.</div>
  </div>

  <button type="submit" class="btn block lg" data-busy="Creating account…">Create account</button>
</form>

<p class="center small muted" style="margin:16px 0 0">
  Already have an account? <a href="/login">Sign in</a>
</p>
