<%#
  Wordmark glyph — a faceted gem whose lower facet doubles as a forward chevron,
  for "a gem, passed on". `mono` renders it in white for the navy topbar.
%>
<% var s = typeof size !== 'undefined' ? size : 26; var m = typeof mono !== 'undefined' && mono; %>
<svg width="<%= s %>" height="<%= s %>" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <% if (m) { %>
    <path d="M16 3.2 27.4 10v12L16 28.8 4.6 22V10L16 3.2Z" fill="rgba(255,255,255,.16)"/>
    <path d="M16 3.2 27.4 10 16 16.6 4.6 10 16 3.2Z" fill="#ffffff" fill-opacity=".92"/>
    <path d="M16 16.6v12.2L4.6 22V10l11.4 6.6Z" fill="#ffffff" fill-opacity=".62"/>
    <path d="M16 16.6v12.2L27.4 22V10L16 16.6Z" fill="#ffffff" fill-opacity=".78"/>
  <% } else { %>
    <defs>
      <linearGradient id="gemTop" x1="4" y1="4" x2="28" y2="17" gradientUnits="userSpaceOnUse">
        <stop stop-color="#24427f"/><stop offset="1" stop-color="#12244a"/>
      </linearGradient>
      <linearGradient id="gemLeft" x1="5" y1="11" x2="16" y2="29" gradientUnits="userSpaceOnUse">
        <stop stop-color="#1a3163"/><stop offset="1" stop-color="#0b1830"/>
      </linearGradient>
      <linearGradient id="gemRight" x1="17" y1="12" x2="28" y2="27" gradientUnits="userSpaceOnUse">
        <stop stop-color="#35a99b"/><stop offset="1" stop-color="#1a3163"/>
      </linearGradient>
    </defs>
    <path d="M16 3.2 27.4 10 16 16.6 4.6 10 16 3.2Z" fill="url(#gemTop)"/>
    <path d="M16 16.6v12.2L4.6 22V10l11.4 6.6Z" fill="url(#gemLeft)"/>
    <path d="M16 16.6v12.2L27.4 22V10L16 16.6Z" fill="url(#gemRight)"/>
    <path d="M16 3.2 27.4 10 16 16.6 4.6 10 16 3.2Z" fill="#ffffff" fill-opacity=".14"/>
  <% } %>
</svg>
