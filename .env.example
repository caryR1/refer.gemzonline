# ---------------------------------------------------------------------------
# refer.GemzOnline — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://rportal.gemzonline.com
APP_NAME=refer.GemzOnline
# Generate with: openssl rand -hex 48
SESSION_SECRET=change-me-to-a-long-random-string
# Set false only if the app is NOT behind a reverse proxy / load balancer
TRUST_PROXY=true

# --- Tenant ------------------------------------------------------------------
# Runs single-tenant. Every row is still scoped to this tenant so the system
# can be sold to external clients later without a data migration.
TENANT_SLUG=gemzonline
TENANT_NAME=GemzOnline

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API Keys
#
# Supabase has two generations of key naming and this app accepts either:
#
#   older projects:  SUPABASE_ANON_KEY          SUPABASE_SERVICE_ROLE_KEY
#   newer projects:  SUPABASE_PUBLISHABLE_KEY   SUPABASE_SECRET_KEY
#
# Set whichever pair your dashboard gives you. The second of each pair is
# SERVER ONLY — it bypasses row level security. Never expose it to a browser,
# never commit it, and rotate it immediately if it leaks.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# or, on a newer project:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# Only on older projects that use symmetric JWT signing:
# Project Settings -> API -> JWT Settings -> JWT Secret.
# Newer projects sign asymmetrically and publish a JWKS URL instead — leave this
# blank there, and sessions are verified against Supabase over the network.
SUPABASE_JWT_SECRET=
# Google sign-in. Also enable the Google provider in Supabase -> Authentication
# -> Providers, and add {APP_URL}/auth/callback as a redirect URL.
GOOGLE_SSO_ENABLED=true

# --- Database ----------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string
#
# USE THE "SESSION POOLER" STRING, not "Direct connection".
#
# Direct connections (db.<ref>.supabase.co) are IPv6-only unless you buy the
# IPv4 add-on. On an IPv4-only network the hostname has no A record at all and
# you get "getaddrinfo ENOTFOUND" — which looks like a typo but is not.
#
# The session pooler has IPv4. Note the username gains the project ref:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#
# Do NOT use the transaction pooler (port 6543): it does not support prepared
# statements, which node-postgres relies on. Session pooler is port 5432.
#
# If your password contains @ : / ? # or %, URL-encode it (@ becomes %40).
#
# NOTE: this is a Postgres connection, NOT one of the API keys above. It uses
# the DATABASE password you set when creating the project. The two are entirely
# separate credentials and neither substitutes for the other.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Email (Hostinger SMTP) --------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@gemzonline.com
SMTP_PASS=your-mailbox-password
MAIL_FROM_NAME=refer.GemzOnline
MAIL_FROM_EMAIL=no-reply@gemzonline.com
ADMIN_ALERT_EMAIL=admin@gemzonline.com

# --- WhatsApp ----------------------------------------------------------------
# Leave disabled until you have a verified WhatsApp Business Account, a
# dedicated number, and your message templates approved by Meta. The app runs
# fine without it — WhatsApp sends are simply skipped and logged as such.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_LANGUAGE=en_US
# Only if WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Analytics ---------------------------------------------------------------
# GA4 measurement ID. Fires on PUBLIC referral pages only, never the portals.
GA4_MEASUREMENT_ID=

# --- Scheduling / timezone ---------------------------------------------------
# Default timezone for new staff accounts. Jamaica is UTC-5 year round, no DST.
STAFF_TIMEZONE=America/Jamaica
ENABLE_CRON=true
JOB_HOUR=7
MONTHLY_REPORT_DAY=1
REMINDER_INTERVAL_MINUTES=15
STALE_LEAD_DAYS=14
