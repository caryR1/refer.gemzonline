# Secrets — never commit these
.env
.env.*
!.env.example

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs and runtime
logs/
*.log
npm-debug.log*
pids/
*.pid
*.seed

# PM2
.pm2/
ecosystem.local.js

# Build and cache
.cache/
dist/
tmp/
.temp/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Uploads written at runtime
public/uploads/

# Any file with "env" in the name that is not the example — catches
# .env_test.txt, env.local, my.env and similar, which the patterns above miss.
*env*.txt
*.env
env.*
!.env.example
